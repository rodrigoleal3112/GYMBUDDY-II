<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GymBuddy" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors in Dark Mode -->
        <item name="colorPrimary">@color/primary_orange_dark_mode</item>
        <item name="colorOnPrimary">@color/surface_dark</item>
        <item name="colorPrimaryContainer">@color/primary_orange_container_dark</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        
        <item name="colorSecondary">@color/primary_orange_light</item>
        <item name="colorOnSecondary">@color/surface_dark</item>

        <item name="android:windowBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        <item name="colorSurfaceVariant">@color/surface_variant_dark</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_dark</item>

        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
