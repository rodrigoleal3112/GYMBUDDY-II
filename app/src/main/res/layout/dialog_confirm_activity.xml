<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- Ícone de Confirmação no topo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_circle_check">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                app:tint="@color/primary_orange" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-black"
            android:text="Confirmar Atividade"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Qualquer atividade precisa de confirmação para gerar seus pontos de XP."
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Card com Detalhes da Atividade Selecionada -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/primary_orange_container"
        app:cardCornerRadius="14dp"
        app:strokeColor="@color/primary_orange_light"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_confirm_act_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_orange"
                    android:fontFamily="sans-serif-bold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="BRAÇO"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_confirm_act_xp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="+50 XP"
                    android:textColor="@color/primary_orange_dark"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_confirm_act_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-bold"
                android:text="Supino Reto"
                android:textColor="@color/text_primary_light"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tv_confirm_act_series_reps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="💪 3 x 10 repetições (20 kg)"
                android:textColor="@color/primary_orange_dark"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_confirm_act_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Exercício para peitoral, ombros e tríceps."
                android:textColor="@color/text_secondary_light"
                android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Instrução -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="Ao confirmar e dar o OK, a atividade encerra e gera seu XP imediatamente!"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp" />

    <!-- Botão com ícone para dar o OK da atividade -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_confirm_act_ok"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/primary_orange"
        android:fontFamily="sans-serif-bold"
        android:text="Dar OK na Atividade (+XP)"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_check"
        app:iconGravity="textStart"
        app:iconTint="@color/white" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_confirm_act_delete"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:text="🗑 Excluir este Treino"
        android:textColor="@color/status_error"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_confirm_act_cancel"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="2dp"
        android:text="Cancelar"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp" />

</LinearLayout>
