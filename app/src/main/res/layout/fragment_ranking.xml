<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Ranking dos Atletas"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tv_ranking_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Suba de nível e dispute o Top 10 com a comunidade"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reset_ranking"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:backgroundTint="@color/status_error_container"
                android:fontFamily="sans-serif-bold"
                android:text="Limpar Ranking"
                android:textColor="@color/status_error"
                android:textSize="12sp"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_refresh"
                app:iconGravity="textStart"
                app:iconTint="@color/status_error"
                app:iconSize="16dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_ranking_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_pill_orange"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="🔥 Temporada Competitiva: Faça treinos para pontuar e liderar o Top 10!"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:gravity="center" />

        <!-- Pódio Top 3 Visual -->
        <LinearLayout
            android:id="@+id/layout_podium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <!-- 2º Lugar -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_podium_second"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/silver"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="🥈 2º"
                        android:textColor="@color/silver"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tv_podium_second_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-bold"
                        android:maxLines="1"
                        android:text="Mariana O."
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_podium_second_xp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="780 XP"
                        android:textColor="@color/primary_orange"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 1º Lugar (Centro mais alto) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_podium_first"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1.2"
                app:cardBackgroundColor="@color/primary_orange_container"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/gold"
                app:strokeWidth="2.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="👑 1º"
                        android:textColor="@color/gold"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tv_podium_first_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-black"
                        android:maxLines="1"
                        android:text="Lucas Silva"
                        android:textColor="@color/primary_orange_dark"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_podium_first_xp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-black"
                        android:text="920 XP"
                        android:textColor="@color/primary_orange_dark"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3º Lugar -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_podium_third"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/bronze"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="🥉 3º"
                        android:textColor="@color/bronze"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tv_podium_third_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-bold"
                        android:maxLines="1"
                        android:text="Carlos E."
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_podium_third_xp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="640 XP"
                        android:textColor="@color/primary_orange"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-bold"
            android:text="Classificação Completa (Top 10)"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp" />

        <ProgressBar
            android:id="@+id/pb_ranking_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/primary_orange"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_ranking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingBottom="80dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
